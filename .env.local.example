# ============================================================================
# RefuncApp — Variáveis de ambiente (copie para .env.local e preencha)
# ============================================================================

# --- Supabase (obrigatórias) ------------------------------------------------
# URL do projeto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública anon (exposta ao browser — NUNCA use a service_role aqui)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service_role (SOMENTE servidor — nunca prefixar com NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# --- Autenticação (obrigatória) ---------------------------------------------
# Segredo de assinatura dos JWTs. Mínimo de 32 caracteres.
# Gere com: openssl rand -base64 48
JWT_SECRET=

# --- Relatórios IA (opcionais) ----------------------------------------------
MOONSHOT_API_KEY=
MOONSHOT_MODEL=
MOONSHOT_TEMPERATURE=
